---
import { MapPin, Mail, Phone } from "@lucide/astro"
---

<section id="contact-section" class="bg-freight-gray-0/30">
    <div class="wrapper">
        <div class="contact-content flex flex-col justify-center gap-4 md:gap-6">
            <h2 class="text-2xl md:text-4xl font-semibold">
                Besoin d'un devis ou d'une information ?
            </h2>

            <p class="text-base leading-relaxed">
                Vous recherchez un équipement professionnel, une fourniture bancaire, un matériel informatique ou un partenaire fiable pour vos opérations d'import-export ? Notre équipe est à votre disposition pour vous conseiller et vous proposer une solution adaptée à vos besoins.
            </p>
            
            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-3">
                    <MapPin class="text-cargo-orange-600"/>
                    <span>Rue Canal+ ACI 2000, BP 7029, Bamako, Mali</span>
                </div>

                <a href="mailto:keitamoulave223@gmail.com" class="flex items-center gap-3 hover:text-cargo-orange-600 transition">
                    <Mail class="text-cargo-orange-600"/>
                    <span>keitamoulave223@gmail.com</span>
                </a>

                <a href="tel:+22370750784" class="flex items-center gap-3 hover:text-cargo-orange-600 transition">
                    <Phone class="text-cargo-orange-600"/>
                    <span>+223 70 75 07 84</span>
                </a>

                <a href="tel:+22367310101" class="flex items-center gap-3 hover:text-cargo-orange-600 transition">
                    <Phone class="text-cargo-orange-600"/>
                    <span>+223 67 31 01 01</span>
                </a>
            </div>
        </div>

        <form class="flex flex-col gap-6 p-8 bg-white/80 rounded-3xl shadow">
            <div class="form-group">
                <label for="name">Nom complet</label>
                <input type="text" name="name" id="name" placeholder="Votre nom"/>
            </div>
            <div class="form-group">
                <label for="email">Adresse email</label>
                <input type="email" name="email" id="email" placeholder="votre@email.com"/>
            </div>   
            <div class="form-group">
                <label for="message">Votre demande</label>
                <textarea rows="5" name="message" id="message" placeholder="Décrivez le produit ou le service recherché..."></textarea>
            </div> 
            <button type="submit" class="btn-primary w-full">
                Demander un devis
            </button>
        </form>
    </div>
</section>

<style>
    @reference "../styles/global.css";

    .wrapper {
        @apply gap-8 md:gap-12;

        display: grid;
        align-items: center;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 450px), 1fr));
    }

    .form-group {
        @apply flex flex-col gap-2;
    }

    label {
        @apply font-medium;
    }

    textarea {
        @apply p-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none transition;
    }
</style>