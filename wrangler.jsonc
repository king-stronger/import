{
	"compatibility_date": "2026-06-05",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "mk-services",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},

	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "fa0ca6caa16e4563821859d9bfab1ad8"
		}
	],

	"observability": {
		"enabled": true
	}
}